<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://kodi.tv/tizen"
        version="@APP_VERSION@"
        viewmodes="maximized">
    <tizen:application id="KodiWasmTv.Kodi" package="KodiWasmTv" required_version="6.5"/>
    <content src="index.html"/>
    <name>Kodi</name>
    <description>Kodi media center (WebAssembly)</description>
    <icon src="icon.png"/>
    <access origin="*" subdomains="true"/>
    <tizen:content-security-policy>*</tizen:content-security-policy>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/drmplay"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
    <!-- The keyboard of the TV is drawn over the app instead of shrinking it. -->
    <tizen:metadata key="http://samsung.com/tv/metadata/use.conformant" value="floating"/>
    <tizen:profile name="tv"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
