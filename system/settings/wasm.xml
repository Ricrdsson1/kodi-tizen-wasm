<?xml version="1.0" encoding="UTF-8"?>
<settings version="1">
  <section id="services">
    <category id="control">
      <group id="1">
        <!-- A service of the TV listens on 8080. -->
        <setting id="services.webserverport">
          <default>8081</default>
        </setting>
      </group>
      <group id="2">
        <setting id="services.esenabled">
          <default>false</default>
        </setting>
      </group>
    </category>
    <category id="filecache">
      <group id="1">
        <!-- The whole cache is in memory, which a TV is short of when a video starts. -->
        <setting id="filecache.memorysize">
          <default>20</default>
        </setting>
      </group>
    </category>
  </section>
</settings>
